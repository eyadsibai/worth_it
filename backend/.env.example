# API Configuration
API_BASE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
STREAMLIT_PORT=8501

# CORS Configuration (comma-separated list of allowed origins)
# For development, leave empty to use defaults (localhost:3000, localhost:8501)
# For production/Vercel, set to your actual domains:
# CORS_ORIGINS=https://worth-it.vercel.app,https://worth-it-*.vercel.app,https://your-domain.com
CORS_ORIGINS=

# Environment
ENVIRONMENT=development  # Options: development, production, testing

# Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Monte Carlo Simulation Limits
MAX_SIMULATIONS=10000

# API Rate Limiting (optional - for production)
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_PER_MINUTE=60

# Trusted Proxies (comma-separated addresses or CIDR blocks)
# Set this whenever the API sits behind a CDN, load balancer, or reverse proxy.
# Those peers are then allowed to identify the real client via X-Forwarded-For;
# without it the socket peer IS the proxy, so every client in front of it shares
# a single rate-limit bucket. Leave empty when the API is directly exposed:
# X-Forwarded-For is attacker-controlled and is ignored unless the immediate
# peer matches one of these entries. A malformed entry fails startup.
# TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16,2001:db8::/32
TRUSTED_PROXIES=
